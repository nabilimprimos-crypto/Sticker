<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════
         VUE KANBAN
    ══════════════════════════════════════════════════════════ -->
    <record id="view_sticker_order_kanban" model="ir.ui.view">
        <field name="name">sticker.order.kanban</field>
        <field name="model">sticker.order</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="stage_id"
                class="o_kanban_small_column"
                group_create="false"
                quick_create="false"
                on_create="quick_create"
            >
                <field name="stage_id"/>
                <field name="kanban_state"/>
                <field name="priority"/>
                <field name="color"/>
                <field name="partner_id"/>
                <field name="artwork_state"/>
                <field name="date_deadline"/>
                <field name="user_id"/>

                <progressbar
                    field="kanban_state"
                    colors='{"done": "success", "blocked": "danger", "normal": "200"}'
                />

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click o_kanban_record_has_image_fill
                            {{ record.priority.raw_value == '1' ? 'o_priority_star' : '' }}">

                            <!-- En-tête : priorité + état kanban -->
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <small class="o_kanban_record_subtitle text-muted">
                                            <field name="product_name"/>
                                        </small>
                                    </div>
                                    <div class="o_kanban_manage_button_section">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                </div>

                                <!-- Client -->
                                <div class="o_kanban_record_body">
                                    <div>
                                        <i class="fa fa-user me-1"/>
                                        <field name="partner_id"/>
                                    </div>
                                    <div t-if="record.date_deadline.raw_value">
                                        <i class="fa fa-calendar me-1"/>
                                        Livraison : <field name="date_deadline"/>
                                    </div>
                                    <!-- Badge artwork -->
                                    <div class="mt-1">
                                        <span t-attf-class="badge
                                            {{ record.artwork_state.raw_value == 'approved' ? 'bg-success' :
                                               record.artwork_state.raw_value == 'rejected' ? 'bg-danger' :
                                               record.artwork_state.raw_value == 'received' ? 'bg-warning' : 'bg-secondary' }}">
                                            Artwork : <field name="artwork_state"/>
                                        </span>
                                    </div>
                                </div>

                                <!-- Pied : responsable + kanban state -->
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="kanban_state" widget="state_selection"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         VUE LISTE
    ══════════════════════════════════════════════════════════ -->
    <record id="view_sticker_order_list" model="ir.ui.view">
        <field name="name">sticker.order.list</field>
        <field name="model">sticker.order</field>
        <field name="arch" type="xml">
            <list string="Commandes sticker" decoration-danger="kanban_state == 'blocked'"
                  decoration-success="kanban_state == 'done'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_name"/>
                <field name="quantity"/>
                <field name="material"/>
                <field name="finish"/>
                <field name="artwork_state"
                       decoration-success="artwork_state == 'approved'"
                       decoration-danger="artwork_state == 'rejected'"
                       decoration-warning="artwork_state == 'received'"
                       widget="badge"/>
                <field name="stage_id"/>
                <field name="kanban_state" widget="state_selection"/>
                <field name="priority" widget="priority"/>
                <field name="date_deadline"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         VUE FORMULAIRE
    ══════════════════════════════════════════════════════════ -->
    <record id="view_sticker_order_form" model="ir.ui.view">
        <field name="name">sticker.order.form</field>
        <field name="model">sticker.order</field>
        <field name="arch" type="xml">
            <form string="Commande sticker">
                <!-- Barre de statut -->
                <header>
                    <field name="stage_id" widget="statusbar"
                           statusbar_visible="1"
                           options="{'clickable': '1'}"/>
                    <button name="action_next_stage" type="object"
                            string="Étape suivante →" class="btn-primary"/>
                    <button name="action_ship" type="object"
                            string="Marquer expédié" class="btn-success"
                            confirm="Confirmer l'expédition de cette commande ?"/>
                </header>

                <sheet>
                    <!-- Titre -->
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="product_name" placeholder="Désignation du sticker..."/></h3>
                    </div>

                    <!-- Priorité + Kanban state -->
                    <div class="oe_right">
                        <field name="priority" widget="priority"/>
                        <field name="kanban_state" widget="state_selection"/>
                    </div>

                    <group>
                        <group string="Informations commande">
                            <field name="partner_id"/>
                            <field name="sale_order_id"/>
                            <field name="date_order"/>
                            <field name="date_deadline"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Détails sticker">
                            <field name="quantity"/>
                            <field name="width_mm"/>
                            <field name="height_mm"/>
                            <field name="material"/>
                            <field name="finish"/>
                            <field name="cut_type"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Onglet Artwork -->
                        <page string="Artwork / Fichier" name="artwork">
                            <group>
                                <group>
                                    <field name="artwork_state" widget="badge"/>
                                </group>
                                <group>
                                    <button name="action_mark_artwork_approved"
                                            type="object" string="Valider artwork"
                                            class="btn-success"
                                            invisible="artwork_state == 'approved'"/>
                                    <button name="action_mark_artwork_rejected"
                                            type="object" string="Rejeter artwork"
                                            class="btn-danger"
                                            invisible="artwork_state == 'rejected'"/>
                                </group>
                            </group>
                            <field name="artwork_notes" placeholder="Notes sur le fichier (résolution, couleurs, remarques...)"/>
                        </page>

                        <!-- Onglet Production -->
                        <page string="Suivi production" name="production">
                            <group>
                                <group string="Impression">
                                    <field name="printer_id"/>
                                    <field name="date_printing_start"/>
                                    <field name="date_printing_end"/>
                                    <button name="action_start_printing" type="object"
                                            string="Démarrer impression"
                                            class="btn-outline-primary"
                                            invisible="date_printing_start != False"/>
                                    <button name="action_end_printing" type="object"
                                            string="Terminer impression"
                                            class="btn-outline-success"
                                            invisible="date_printing_end != False"/>
                                </group>
                                <group string="Découpe / Finition">
                                    <field name="cutter_id"/>
                                    <field name="date_cutting_end"/>
                                </group>
                            </group>
                            <group string="Expédition">
                                <field name="date_qc"/>
                                <field name="date_shipped"/>
                            </group>
                        </page>

                        <!-- Onglet Notes -->
                        <page string="Notes internes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         VUE RECHERCHE
    ══════════════════════════════════════════════════════════ -->
    <record id="view_sticker_order_search" model="ir.ui.view">
        <field name="name">sticker.order.search</field>
        <field name="model">sticker.order</field>
        <field name="arch" type="xml">
            <search string="Rechercher commandes">
                <field name="name" string="Référence"/>
                <field name="partner_id" string="Client"/>
                <field name="product_name" string="Produit"/>
                <separator/>
                <filter string="Urgentes" name="urgent" domain="[('priority','=','1')]"/>
                <filter string="Artwork en attente" name="artwork_pending"
                        domain="[('artwork_state','in',['pending','received'])]"/>
                <filter string="Bloquées" name="blocked"
                        domain="[('kanban_state','=','blocked')]"/>
                <filter string="Expédiées" name="shipped"
                        domain="[('date_shipped','!=',False)]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Étape" name="group_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Client" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Matière" name="group_material" context="{'group_by': 'material'}"/>
                    <filter string="Responsable" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         ACTION
    ══════════════════════════════════════════════════════════ -->
    <record id="action_sticker_order" model="ir.actions.act_window">
        <field name="name">Commandes de fabrication</field>
        <field name="res_model">sticker.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_sticker_order_search"/>
        <field name="context">{'search_default_group_stage': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première commande de sticker !
            </p>
        </field>
    </record>

</odoo>
